# ── Required ──────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Web search (optional) ──────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Gmail OAuth2 ───────────────────────────────
# Get from: https://console.cloud.google.com
# Create project → Enable Gmail API → Create OAuth2 credentials (Desktop app)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Outlook / Office 365 OAuth2 ────────────────
# Get from: https://portal.azure.com
# App registrations → New registration → Platform: Mobile/Desktop
MICROSOFT_CLIENT_ID=your_microsoft_client_id

# ── Telegram remote commands (optional) ────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Email remote commands (optional) ───────────
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com

# ── Server ─────────────────────────────────────
SERVER_PORT=8787
